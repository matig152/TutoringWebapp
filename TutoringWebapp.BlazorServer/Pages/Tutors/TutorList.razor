@page "/tutors"
@inject ITutorService TutorService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Tutors</PageTitle>

<div class="row mb-4">
    <div class="col-6">
        <h1>Tutors</h1>
    </div>
    <div class="col-6 text-end">
        <RadzenButton Click=@(() => NavigationManager.NavigateTo("/tutors/create")) Text="Add New Tutor" Icon="add" ButtonStyle="ButtonStyle.Primary" />
    </div>
</div>

<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="5" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
    Data="@_tutors" TItem="TutorDto" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or">
    <Columns>
        <RadzenDataGridColumn TItem="TutorDto" Title="Photo" Frozen="true" Sortable="false" Filterable="false" Width="80px" TextAlign="TextAlign.Center">
            <Template Context="tutor">
                <RadzenImage Path="@tutor.ImageUrl" style="width: 40px; height: 40px; border-radius: 50%;" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="TutorDto" Property="FirstName" Title="First Name" Frozen="true" Width="140px" />
        <RadzenDataGridColumn TItem="TutorDto" Property="LastName" Title="Last Name" Width="140px" />
        <RadzenDataGridColumn TItem="TutorDto" Title="Subjects" Width="220px">
            <Template Context="tutor">
                @if (tutor.TaughtSubjects != null)
                {
                    @foreach (var subject in tutor.TaughtSubjects)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" IsPill="true" Text="@subject.Name" class="me-1" />
                    }
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="TutorDto" Property="HourlyRate" Title="Rate" Width="100px">
            <Template Context="tutor">
                @String.Format(new System.Globalization.CultureInfo("pl-PL"), "{0:C}", tutor.HourlyRate)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="TutorDto" Title="Actions" Width="140px" Context="tutor">
            <Template>
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="@(() => NavigationManager.NavigateTo($"/tutors/edit/{tutor.Id}"))" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteTutor(tutor))" class="ms-1" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private IEnumerable<TutorDto> _tutors;

    protected override void OnInitialized()
    {
        _tutors = TutorService.GetAll();
    }

    private async Task DeleteTutor(TutorDto tutor)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {tutor.FirstName} {tutor.LastName}?");
        if (confirm)
        {
            TutorService.Delete(tutor.Id);
            _tutors = TutorService.GetAll();
        }
    }
}
